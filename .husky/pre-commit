#!/bin/sh
# CSK2 Pre-commit Hook
# Catches common mistakes before they reach the repo

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo ""
echo "🛡️  Pre-commit checks..."
echo ""

ERRORS=0

# ─── 1. Block commits to main/master ───
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo "${RED}❌ Cannot commit directly to $BRANCH${NC}"
  echo "   Create a feature branch: git checkout -b feature/your-feature"
  exit 1
fi
echo "${GREEN}✓${NC} Branch: $BRANCH"

# ─── 2. Check for debug statements ───
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts|jsx|tsx|py)$' || true)

if [ -n "$STAGED_FILES" ]; then
  # Check for console.log (JS/TS)
  CONSOLE_LOGS=$(echo "$STAGED_FILES" | xargs grep -l 'console\.log' 2>/dev/null || true)
  if [ -n "$CONSOLE_LOGS" ]; then
    echo "${YELLOW}⚠️  console.log found in:${NC}"
    echo "$CONSOLE_LOGS" | sed 's/^/   /'
    # Warning only, don't block
  fi

  # Check for debugger statements
  DEBUGGERS=$(echo "$STAGED_FILES" | xargs grep -l 'debugger' 2>/dev/null || true)
  if [ -n "$DEBUGGERS" ]; then
    echo "${RED}❌ debugger statement found in:${NC}"
    echo "$DEBUGGERS" | sed 's/^/   /'
    ERRORS=1
  fi

  # Check for print() in Python (common debug leftover)
  PY_FILES=$(echo "$STAGED_FILES" | grep '\.py$' || true)
  if [ -n "$PY_FILES" ]; then
    PRINTS=$(echo "$PY_FILES" | xargs grep -l '^[^#]*print(' 2>/dev/null || true)
    if [ -n "$PRINTS" ]; then
      echo "${YELLOW}⚠️  print() found in:${NC}"
      echo "$PRINTS" | sed 's/^/   /'
      # Warning only
    fi
  fi
fi

# ─── 3. Check for large files ───
LARGE_FILES=$(git diff --cached --name-only --diff-filter=ACM | while read file; do
  if [ -f "$file" ]; then
    SIZE=$(wc -c < "$file" 2>/dev/null || echo 0)
    if [ "$SIZE" -gt 1000000 ]; then  # 1MB
      echo "$file ($(numfmt --to=iec $SIZE 2>/dev/null || echo "${SIZE}B"))"
    fi
  fi
done)

if [ -n "$LARGE_FILES" ]; then
  echo "${YELLOW}⚠️  Large files (>1MB):${NC}"
  echo "$LARGE_FILES" | sed 's/^/   /'
fi

# ─── 4. Check for secrets ───
SECRET_PATTERNS='(password|secret|api_key|apikey|token|credential).*=.*["\x27][^"\x27]{8,}'
SECRETS=$(git diff --cached --name-only --diff-filter=ACM | xargs grep -ilE "$SECRET_PATTERNS" 2>/dev/null || true)

if [ -n "$SECRETS" ]; then
  echo "${RED}❌ Possible secrets found in:${NC}"
  echo "$SECRETS" | sed 's/^/   /'
  echo "   Use environment variables instead!"
  ERRORS=1
fi

# ─── Result ───
echo ""
if [ $ERRORS -gt 0 ]; then
  echo "${RED}Pre-commit failed. Fix errors above.${NC}"
  echo "To skip (not recommended): git commit --no-verify"
  exit 1
fi

echo "${GREEN}✓ Pre-commit checks passed${NC}"
echo ""
